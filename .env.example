# Скопируйте в .env: cp .env.example .env — docker compose подхватит его сам.
# .env в git не попадает (.gitignore); на сервере свой .env, деплой его не трогает.

# Токен GitHub (read-only, без scopes): история звёзд за дни/месяцы, активность, возраст аккаунтов
GITHUB_TOKEN=
# http — реальный GH Archive; fixture — офлайн-демо на синтетике
APP_ARCHIVE_MODE=http
# real — реальные проверки; mock — стабильные демо-профили
APP_SCORING_MODE=real
APP_GITHUB_ENABLED=true
# трекер звёзд в PostgreSQL (снимки раз в 5 минут)
APP_TRACKER_ENABLED=true
