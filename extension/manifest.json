{
  "manifest_version": 3,
  "name": "Star Guard",
  "short_name": "Star Guard",
  "version": "0.1.0",
  "description": "Показывает признаки накрутки звёзд прямо на страницах GitHub: оценку, причины и график звёзд.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Star Guard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://201.51.23.42/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/ui.js", "src/easter.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
